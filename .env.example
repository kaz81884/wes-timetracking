# Used by server/index.js (local dev) to send "forgot PIN" reset emails via Resend.
# Get a key at https://resend.com — the free tier is plenty for this.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sandbox sender, which can only email
# the address on your Resend account. Verify your own domain in Resend and
# set this to send to your whole team, e.g. "Ledger <noreply@yourcompany.com>".
RESEND_FROM=Ledger <onboarding@resend.dev>
